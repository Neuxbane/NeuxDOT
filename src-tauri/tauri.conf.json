{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeuxDOT",
  "version": "0.1.0",
  "identifier": "com.neuxdot.app",
  "build": {
    "beforeDevCommand": "pnpm --filter web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter web build",
    "frontendDist": "../apps/web/build"
  },
  "app": {
    "windows": [
      {
        "title": "NeuxDOT",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
